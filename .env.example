# Curso Avanzado de IA Generativa 2025
# Copia este archivo a .env y completa con tus API keys

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini)
GOOGLE_API_KEY=...

# Cohere
COHERE_API_KEY=...

# Hugging Face
HUGGINGFACE_API_KEY=hf_...

# Vector Databases
PINECONE_API_KEY=...
PINECONE_ENVIRONMENT=...
WEAVIATE_URL=...
WEAVIATE_API_KEY=...
QDRANT_URL=...
QDRANT_API_KEY=...

# Monitoring & Observability
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=curso-ia-generativa
WANDB_API_KEY=...

# Multimodal APIs
ELEVENLABS_API_KEY=...
REPLICATE_API_KEY=...

# Neo4j (para GraphRAG)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=...

# Configuración General
MODEL_TEMPERATURE=0.7
MAX_TOKENS=4000
VERBOSE=true
